int y = 0;
while (y < 10)
{
    y++;
    if (y % 2 == 0)
    {
        continue;
    }
    Console.WriteLine(y);
}
   
----------------------------------

int satirSayisi = 5;
int i = 1;
while (i <= satirSayisi)
{
    int j = 1;
    while (j <= i)
    {
        Console.Write("*");
        j++;
    }
    Console.WriteLine();
    i++;
}

